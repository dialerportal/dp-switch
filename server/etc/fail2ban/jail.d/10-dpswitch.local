[DEFAULT]
# ban at the firewall via nftables (matches the host's nft ruleset)
banaction  = nftables-multiport
backend    = auto
# never lock out the operator's own addresses
ignoreip = 127.0.0.1/8 ::1

[dpswitch-auth]
enabled  = true
filter   = dpswitch-auth
logpath  = /var/www/dpswitch/storage/logs/auth.log
port     = http,https
findtime = 10m
maxretry = 5
bantime  = 1w
# repeat offenders get progressively longer bans
bantime.increment = true
bantime.factor    = 4
bantime.maxtime   = 90d

[dpswitch-probe]
enabled  = true
filter   = dpswitch-probe
logpath  = /var/log/nginx/dpswitch_access.log
port     = http,https
findtime = 5m
maxretry = 20
bantime  = 1w
bantime.increment = true
bantime.maxtime   = 90d

[DEFAULT]
banaction = nftables-multiport
ignoreip = 127.0.0.1/8 ::1

# SIP auth failures / floods / malformed packets, read straight from the journal
# (this host has no rsyslog — journald is the only log sink).
[dpsip-auth]
enabled      = true
filter       = dpsip-auth
backend      = systemd
journalmatch = _SYSTEMD_UNIT=kamailio.service
port         = 5060,5061
protocol     = tcp,udp
findtime     = 10m
maxretry     = 5
bantime  = 1w
bantime.increment = true
bantime.factor    = 6
bantime.maxtime   = 90d

# Extension enumeration seen at the portal's SIP directory endpoint.
[dpsip-scanner]
enabled  = true
filter   = dpsip-scanner
logpath  = /var/www/dpswitch/storage/logs/auth.log
port     = 5060,5061
protocol = tcp,udp
findtime = 10m
maxretry = 4
bantime  = 1w
bantime.increment = true
bantime.maxtime   = 90d
